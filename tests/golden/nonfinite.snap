=== values ===
zero_over_zero = NaN dimensionless
zero_times_infinity = NaN dimensionless
root_of_negative = NaN dimensionless
log_of_negative = NaN dimensionless
arcsine_out_of_range = NaN dimensionless
infinity_less_infinity = NaN dimensionless
positive = inf dimensionless
negative = -inf dimensionless
with_units = inf m
negative_zero = -0.0 dimensionless
positive_zero = 0.0 dimensionless
sum_of_zeros = 0.0 dimensionless
reciprocal_of_negative_zero = -inf dimensionless

