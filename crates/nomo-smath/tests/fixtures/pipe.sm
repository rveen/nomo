<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<?application progid="SMath Studio" version="1.5.0.9678"?>
<worksheet xmlns="http://smath.info/schemas/worksheet/1.0">
  <settings ppi="96">
    <identity>
      <id>00000000-0000-4000-8000-000000000001</id>
      <revision>1</revision>
    </identity>
    <calculation>
      <precision>6</precision>
      <significantDigitsMode>true</significantDigitsMode>
    </calculation>
  </settings>
  <regions type="content">
  <region left="18" top="20" width="320" height="24" color="#000000" fontSize="10">
    <text lang="eng"><p>A pipe run, sized for a target velocity. Written in SMath and imported by Nomo.</p></text>
  </region>
  <region left="18" top="60" width="320" height="24" color="#000000" fontSize="10">
    <math>
      <input>
        <e type="operand">g</e>
        <e type="operand">9.81</e>
        <e type="operand" style="unit">m</e>
        <e type="operand" style="unit">s</e>
        <e type="operand">2</e>
        <e type="operator" args="2">^</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">≡</e>
      </input>
    </math>
  </region>
  <region left="18" top="100" width="320" height="24" color="#000000" fontSize="10">
    <text lang="eng"><p>The pipe, and the flow it has to carry.</p></text>
  </region>
  <region left="18" top="140" width="320" height="24" color="#000000" fontSize="10">
    <math>
      <input>
        <e type="operand">d</e>
        <e type="operand">100</e>
        <e type="operand" style="unit">mm</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
  </region>
  <region left="18" top="180" width="320" height="24" color="#000000" fontSize="10">
    <math>
      <input>
        <e type="operand">Q</e>
        <e type="operand">15</e>
        <e type="operand" style="unit">L</e>
        <e type="operand" style="unit">s</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
  </region>
  <region left="18" top="220" width="320" height="24" color="#000000" fontSize="10">
    <math>
      <input>
        <e type="operand">A</e>
        <e type="operand">π</e>
        <e type="operand">d</e>
        <e type="operand">2</e>
        <e type="operator" args="2">^</e>
        <e type="operator" args="2">*</e>
        <e type="operand">4</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
  </region>
  <region left="18" top="260" width="320" height="24" color="#000000" fontSize="10">
    <math>
      <input>
        <e type="operand">v</e>
        <e type="operand">Q</e>
        <e type="operand">A</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
  </region>
  <region left="18" top="300" width="320" height="24" color="#000000" fontSize="10">
    <text lang="eng"><p>The velocity that produces, against a 2.5 m/s limit for a pumped water main.</p></text>
  </region>
  <region left="18" top="340" width="320" height="24" color="#000000" fontSize="10">
    <math>
      <input>
        <e type="operand">v</e>
      </input>
      <result action="numeric">
        <e type="operand">1.90986</e>
        <e type="operand" style="unit">m</e>
        <e type="operand" style="unit">s</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">*</e>
      </result>
    </math>
  </region>
  <region left="18" top="380" width="320" height="24" color="#000000" fontSize="10">
    <math>
      <input>
        <e type="operand">A</e>
      </input>
      <result action="numeric">
        <e type="operand">7853.98</e>
        <e type="operand" style="unit">mm</e>
        <e type="operand">2</e>
        <e type="operator" args="2">^</e>
        <e type="operator" args="2">*</e>
      </result>
    </math>
  </region>
  <region left="18" top="420" width="320" height="24" color="#000000" fontSize="10">
    <text lang="eng"><p>A construct Nomo does not translate, so that a refusal can be seen too.</p></text>
  </region>
  <region left="18" top="460" width="320" height="24" color="#000000" fontSize="10">
    <math>
      <input>
        <e type="operand">expr</e>
        <e type="operand">Q</e>
        <e type="function" args="1">Maxima</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
  </region>
  </regions>
</worksheet>
