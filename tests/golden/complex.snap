<div class="step"><span class="name">Z</span><span class="eq">=</span>(3 + 4 i) Ω<span class="eq">=</span><span class="result">(3 + 4i) Ω</span></div>
<div class="step">Z<span class="eq">=</span><span class="result">(0.003 + 0.004i) kΩ</span></div>
