<div class="step"><span class="name">A_min</span><span class="eq">=</span>I_load/J_max<span class="eq">=</span><span class="subst">15.6522 A/(6000000 m⁻²·A)</span><span class="eq">=</span><span class="result">2.6087e-6 m²</span></div>
<div class="step">A_min<span class="eq">=</span><span class="result">2.6087 mm²</span></div>
